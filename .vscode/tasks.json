{
	// Auto-launches the backend dev server whenever this folder is opened in
	// VS Code, in its own dedicated terminal panel — one less manual step.
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Backend Server",
			"type": "shell",
			"icon": { "id": "server", "color": "terminal.ansiGreen" },
			"isBackground": true,
			"runOptions": { "runOn": "folderOpen" },
			"command": "cd backend && npm run dev",
			"presentation": {
				"echo": false,
				"focus": false,
				"panel": "dedicated",
				"group": "server"
			}
		}
	]
}
