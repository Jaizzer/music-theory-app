# Copy this file to `.env` and fill in real values. `.env` itself is
# gitignored — never commit real secrets. See src/config/env.ts for exactly
# how (and when) each of these is required.

# --- Server -------------------------------------------------------------
PORT=3000
# development | test | production — controls which *_DATABASE_URL below is
# used, and switches Better Auth's baseURL between localhost and PRODUCTION_URL.
NODE_ENV=development

# --- Database (pick the one matching NODE_ENV) ---------------------------
# Local Postgres connection strings. Format:
#   postgresql://<user>:<password>@<host>:<port>/<database>
DEVELOPMENT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/music_theory_app_development
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/music_theory_app_test
# Only needed when NODE_ENV=production.
PRODUCTION_DATABASE_URL=

# --- Auth (Better Auth) ---------------------------------------------------
# A long random string used to sign session tokens. Generate one with:
#   openssl rand -hex 32
BETTER_AUTH_SECRET=

# Only needed when NODE_ENV=production — the public URL Better Auth should
# treat as its own origin (e.g. https://api.yourdomain.com).
PRODUCTION_URL=

# --- Frontend origin -------------------------------------------------------
# Defaults to http://localhost:5173 (Vite's dev port, see
# frontend/vite.config.ts) in development, so you only need to set this
# explicitly in production.
FRONTEND_URL=

# --- Google OAuth (optional) ----------------------------------------------
# Leave all three blank to run with email/password auth only. Set all three
# together to also enable "Sign in with Google" — get them from
# https://console.cloud.google.com/apis/credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_REDIRECT_URI=
